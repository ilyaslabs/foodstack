<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>io.github.ilyaslabs</groupId>
    <artifactId>foodstack</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>FoodStack</name>
    <description>Open-source food ordering and delivery platform: a modular monolith built on Module-Switch.</description>
    <url>https://github.com/ilyaslabs/foodstack</url>
    <inceptionYear>2026</inceptionYear>

    <licenses>
        <license>
            <name>Fair Revenue Share License v1</name>
            <url>https://ilyaslabs.github.io/docs/licenses/fair-revenue-v1</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>ilyaslabs</id>
            <name>Muhammad ilyas</name>
            <organizationUrl>https://ilyaslabs.github.io/</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/ilyaslabs/foodstack.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/ilyaslabs/foodstack.git</developerConnection>
        <url>https://github.com/ilyaslabs/foodstack</url>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/ilyaslabs/foodstack/issues</url>
    </issueManagement>

    <modules>
        <module>foodstack-bom</module>
        <module>platform</module>
        <module>modules</module>
        <module>app</module>
        <module>integration-tests</module>
        <module>deploy/unit-deployer</module>
    </modules>

    <properties>
        <!-- Overridden by the release workflows: -Drevision=<tag> -->
        <revision>0.1.0-SNAPSHOT</revision>
        <java.version>25</java.version>
        <!-- Agents such as JaCoCo append to this. -->
        <argLine></argLine>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <module-switch.version>0.0.1</module-switch.version>
        <liquibase-mongodb.version>5.0.4</liquibase-mongodb.version>
        <awssdk.version>2.57.7</awssdk.version>
        <uuid-creator.version>6.1.1</uuid-creator.version>
        <bouncycastle.version>1.86</bouncycastle.version>
        <webp-imageio.version>0.11.0</webp-imageio.version>
        <metadata-extractor.version>2.22.0</metadata-extractor.version>
        <archunit.version>1.5.1</archunit.version>
        <instancio.version>6.1.0</instancio.version>
        <rest-assured.version>6.3.0</rest-assured.version>

        <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
        <node.version>v24.22.2</node.version>
        <pnpm.version>10.28.0</pnpm.version>

        <flatten-maven-plugin.version>1.8.0</flatten-maven-plugin.version>
        <central-publishing-maven-plugin.version>0.12.0</central-publishing-maven-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- FoodStack artifacts (same list as foodstack-bom, which cannot be imported inside its own reactor) -->
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>foodstack-platform-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>foodstack-platform-web</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>foodstack-platform-mongo</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>foodstack-platform-kafka</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>foodstack-platform-security</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>foodstack-platform-test</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>foodstack-identity-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>foodstack-identity-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>foodstack-identity-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>foodstack-identity-web</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>foodstack-settings-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>foodstack-settings-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>foodstack-settings-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>foodstack-settings-web</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>foodstack-media-api</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>foodstack-media-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>foodstack-media-impl</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>foodstack-media-web</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.github.ilyaslabs</groupId>
                <artifactId>module-switch-bom</artifactId>
                <version>${module-switch.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.liquibase.ext</groupId>
                <artifactId>liquibase-mongodb</artifactId>
                <version>${liquibase-mongodb.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.f4b6a3</groupId>
                <artifactId>uuid-creator</artifactId>
                <version>${uuid-creator.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.usefulness</groupId>
                <artifactId>webp-imageio</artifactId>
                <version>${webp-imageio.version}</version>
            </dependency>
            <dependency>
                <groupId>com.drewnoakes</groupId>
                <artifactId>metadata-extractor</artifactId>
                <version>${metadata-extractor.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
            <dependency>
                <groupId>org.instancio</groupId>
                <artifactId>instancio-junit</artifactId>
                <version>${instancio.version}</version>
            </dependency>
            <dependency>
                <groupId>io.rest-assured</groupId>
                <artifactId>rest-assured</artifactId>
                <version>${rest-assured.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-Xlint:all,-processing,-serial,-try</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <!-- Mockito attaches its agent at runtime on JDK 25 unless told otherwise. -->
                        <argLine>@{argLine} -XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
                        <trimStackTrace>false</trimStackTrace>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>ossrh</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Publishing to Maven Central. The ilyaslabs/cicd release and snapshot workflows run
          `mvn deploy -Drevision=...` with MAVEN_USERNAME set, which switches this profile on.
        -->
        <profile>
            <id>central-release</id>
            <activation>
                <property>
                    <name>env.MAVEN_USERNAME</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <configuration>
                                    <gpgArguments>
                                        <arg>--pinentry-mode</arg>
                                        <arg>loopback</arg>
                                    </gpgArguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-maven-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <excludeArtifacts>
                                <artifact>foodstack-integration-tests</artifact>
                                <artifact>foodstack-unit-deployer</artifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
