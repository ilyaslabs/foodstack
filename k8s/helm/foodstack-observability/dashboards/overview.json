        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"foodstack-server\", namespace=~\"$namespace\", uri=~\"/api/.*\"}[5m]))",
