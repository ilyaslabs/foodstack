{
  "uid": "foodstack-overview",
  "title": "FoodStack overview",
  "description": "Traffic, errors, latency and resources of every FoodStack pod group.",
  "tags": [
    "foodstack"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
