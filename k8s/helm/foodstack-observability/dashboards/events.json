        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (messaging_kafka_consumer_group, messaging_source_name) (rate(spring_kafka_listener_seconds_count{job=\"foodstack-server\", namespace=~\"$namespace\", error!=\"none\"}[5m]))",
          "legendFormat": "{{messaging_kafka_consumer_group}} on {{messaging_source_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
