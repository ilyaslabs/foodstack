      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(foodstack_dispatch_delivery_time_seconds_bucket{job=\"foodstack-server\", namespace=~\"$namespace\"}[30m])))",
          "legendFormat": "median",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(foodstack_dispatch_delivery_time_seconds_bucket{job=\"foodstack-server\", namespace=~\"$namespace\"}[30m])))",
          "legendFormat": "95 %",
          "datasource": {
