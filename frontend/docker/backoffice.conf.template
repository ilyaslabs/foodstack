# Back office static files under /admin/, with a runtime config.json (TDD 14.2).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    location = /admin/config.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '{"apiUrl":"${FOODSTACK_API_URL}","issuer":"${FOODSTACK_ISSUER}","clientId":"foodstack-backoffice"}';
    }

    # Hashed bundles never change; cache them for a year.
    location ~* ^/admin/.+\.(js|css|woff2?|png|svg|ico|webp)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Client-side routes fall back to the app shell.
    location /admin/ {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'";
        try_files $uri $uri/ /admin/index.html;
    }
}
