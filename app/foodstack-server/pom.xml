<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.ilyaslabs</groupId>
        <artifactId>foodstack-app</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>foodstack-server</artifactId>
    <name>FoodStack server</name>
    <description>The FoodStack server: every module in one Spring Boot application. Module-Switch decides per
        deployment which modules run here, which are called over HTTP and which are off.</description>

    <dependencies>
        <dependency>
            <groupId>io.github.ilyaslabs</groupId>
            <artifactId>module-switch-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Modules: core (logic and data), impl (module API) and web (REST) of each -->
        <dependency>
            <groupId>io.github.ilyaslabs</groupId>
            <artifactId>foodstack-identity-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ilyaslabs</groupId>
            <artifactId>foodstack-identity-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ilyaslabs</groupId>
            <artifactId>foodstack-identity-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ilyaslabs</groupId>
            <artifactId>foodstack-settings-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ilyaslabs</groupId>
            <artifactId>foodstack-settings-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ilyaslabs</groupId>
            <artifactId>foodstack-settings-web</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ilyaslabs</groupId>
            <artifactId>foodstack-media-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ilyaslabs</groupId>
            <artifactId>foodstack-media-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ilyaslabs</groupId>
            <artifactId>foodstack-media-web</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.ilyaslabs</groupId>
            <artifactId>module-switch-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.github.ilyaslabs</groupId>
            <artifactId>foodstack-platform-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                        <configuration>
                            <!-- The plain jar stays the main artifact so integration-tests can depend on it. -->
                            <classifier>exec</classifier>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>io.github.ilyaslabs.foodstack.FoodstackApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
