# The single-server gateway (TDD 17.2): TLS, routing by path, rate limits and security headers.
# FOODSTACK_SITES lists the site addresses, for example
#   "example.com, admin.example.com, api.example.com"   (automatic HTTPS)
#   "http://localhost"                                   (local trial without TLS)
{
	servers {
		trusted_proxies static private_ranges
	}
	order rate_limit before basic_auth
}

(foodstack) {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# Edge rate limits per client address (TDD 18.3), before any request reaches the server: one
	# budget for the whole API, a tighter one for sign-in and order placement. Over the limit the
	# answer is 429 with Retry-After. Limits are per minute, from .env; the server keeps its own
	# per-user limits as well. Mobile networks put many people behind one address, so stay generous.
	rate_limit {
		zone api {
			match {
				path /api/* /oauth2/*
			}
			key {client_ip}
			events {$FOODSTACK_RATE_LIMIT_API:1200}
			window 1m
		}
		zone auth {
			match {
				path /api/v1/auth/*
			}
			key {client_ip}
			events {$FOODSTACK_RATE_LIMIT_SIGN_IN:60}
			window 1m
		}
		zone orders {
			match {
				method POST
				path /api/v1/orders
			}
			key {client_ip}
			events {$FOODSTACK_RATE_LIMIT_ORDERS:20}
			window 1m
		}
	}

	# The API (sign-in included) and the token keys: the FoodStack server (every module local).
	@server path /api/* /oauth2/* /.well-known/* /actuator/health/*
	handle @server {
		reverse_proxy server:8080 {
			health_uri /actuator/health/readiness
		}
	}

	# Media buckets: presigned uploads and public images go straight to object storage. The Host
	# header is passed unchanged, so upload signatures made for this hostname stay valid.
	@storage path /foodstack-public/* /foodstack-private/*
	handle @storage {
		reverse_proxy storage:9000
	}

	# The back office; on its own hostname the root opens it.
	handle /admin* {
		reverse_proxy backoffice:8080
	}
	@adminRoot {
		host {$FOODSTACK_ADMIN_ROOT_HOST}
		path /
	}
	redir @adminRoot /admin/ 302

	# Everything else: the customer app (server-side rendered).
	handle {
		reverse_proxy web:4000
	}
}

{$FOODSTACK_SITES} {
	import foodstack
}
