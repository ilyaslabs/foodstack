# FoodStack single-server settings. install.sh writes the real .env (mode 600) with generated
# secrets; edit it afterwards and run ./restart.sh server. Keep a copy in a password manager:
# FOODSTACK_PII_KEY cannot be recovered, and without it encrypted personal data is unreadable.

# --- Version and environment ---
FOODSTACK_VERSION=0.1.0
FOODSTACK_ENVIRONMENT=production

# --- Hostnames (deployment guide 2.1). One hostname for all three also works. ---
FOODSTACK_DOMAIN=example.com
FOODSTACK_ADMIN_DOMAIN=admin.example.com
FOODSTACK_API_DOMAIN=api.example.com
# Caddy site addresses; "http://..." disables automatic HTTPS (local trials only).
FOODSTACK_SITES=example.com, admin.example.com, api.example.com
# The same hostnames without scheme, comma separated (server-side rendering answers only these).
FOODSTACK_HOSTNAMES=example.com,admin.example.com,api.example.com
# The hostname whose root opens the back office; "no-admin-host.invalid" when it shares the domain.
FOODSTACK_ADMIN_ROOT_HOST=admin.example.com
# Public URLs. The API URL is also the token issuer.
FOODSTACK_PUBLIC_URL=https://api.example.com
FOODSTACK_WEB_URL=https://example.com
FOODSTACK_ADMIN_URL=https://admin.example.com
# Keep true. false only for a plain-HTTP trial (install.sh --local sets it).
FOODSTACK_REFRESH_COOKIE_SECURE=true
# Tracing: send spans over OTLP (HTTP) to a collector such as Jaeger, Tempo or an OpenTelemetry
# Collector. Off by default; the share of requests traced is FOODSTACK_TRACING_SAMPLING (0 to 1).
FOODSTACK_TRACING_EXPORT=false
FOODSTACK_OTLP_ENDPOINT=http://localhost:4318/v1/traces
FOODSTACK_TRACING_SAMPLING=0.1
HTTP_PORT=80
HTTPS_PORT=443

# --- First administrator, created on first start when no account with this email exists ---
FOODSTACK_ADMIN_EMAIL=ops@example.com
FOODSTACK_ADMIN_PASSWORD=change-me-generated-by-install

# --- Keys (generated by install.sh) ---
# ES256 signing keys, PKCS#8 PEM bodies without headers, comma separated; the first one signs.
FOODSTACK_SIGNING_KEYS=
# 32 random bytes, base64.
FOODSTACK_PII_KEY=

# --- Datastores (passwords generated by install.sh) ---
MONGODB_PASSWORD=
REDIS_PASSWORD=
KAFKA_CLUSTER_ID=
ELASTICSEARCH_PASSWORD=
KAFKA_TOPIC_PARTITIONS=24
KAFKA_REPLICATION_FACTOR=1

# --- Media storage: your own S3-compatible buckets (handbook guide 12) ---
# Required for a real install; install.sh writes these from --settings. The server checks the
# buckets on every start (both writable, the public one readable by everyone at
# S3_PUBLIC_BASE_URL, CORS for your two sites) and does not start until they work.
S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
S3_REGION=eu-west-1
# false for Amazon S3 (bucket name in the host); true for Cloudflare R2 and Backblaze B2.
S3_PATH_STYLE=false
S3_PUBLIC_BUCKET=foodstack-public
S3_PRIVATE_BUCKET=foodstack-private
# Where browsers load the public bucket's files: its public URL or your CDN.
S3_PUBLIC_BASE_URL=https://foodstack-public.s3.eu-west-1.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Where browsers send uploads (empty = S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=
# Addresses the back office may load images from and upload to (derived by install.sh).
MEDIA_ORIGINS=
# A --local trial only: photos kept on this computer in a local stand-in.
# FOODSTACK_TRIAL_STORAGE=true

# --- Address search (handbook guide 13) ---
# Required: google (Geocoding API, with GOOGLE_MAPS_API_KEY) or nominatim (any Nominatim-compatible
# service at GEOCODING_URL). OpenStreetMap's public Nominatim is used only by --local trials.
GEOCODING_PROVIDER=nominatim
GEOCODING_URL=https://search.example-provider.com
# Your country's ISO code, such as pk: results are limited to it.
GEOCODING_COUNTRY_CODES=
# Google Maps Platform key, with the Geocoding API and Routes API on (google only).
GOOGLE_MAPS_API_KEY=

# --- Map tiles (back office delivery zones, live tracking) ---
# Required: any {z}/{x}/{y} tile service and the credit it asks for. MAP_TILE_ORIGIN must be the
# scheme and host of MAP_TILE_URL (install.sh derives it).
MAP_TILE_URL=https://tiles.example-provider.com/{z}/{x}/{y}.png?key=...
MAP_TILE_ORIGIN=https://tiles.example-provider.com
MAP_ATTRIBUTION=© Example provider © OpenStreetMap contributors

# --- Road distance and driving time (delivery quotes, dispatch, live ETAs) ---
# none: straight-line distance times a road factor at an urban average speed (good enough to start).
# osrm: an OSRM server you run (or a hosted one) for real road distances, e.g. http://osrm:5000.
# google: the Routes API, with GOOGLE_MAPS_API_KEY.
ROUTING_PROVIDER=none
ROUTING_URL=

# --- Push notifications (riders' new jobs, customers' order updates) ---
# Create a Firebase project, then:
# FCM_SERVICE_ACCOUNT: Project settings > Service accounts > Generate new private key. Save the file
#   as config/push/fcm.json in this folder and set FCM_SERVICE_ACCOUNT=/config/push/fcm.json.
# FCM_WEB_CONFIG: Project settings > General > your web app's firebaseConfig, as one-line JSON, e.g.
#   {"apiKey":"...","projectId":"...","messagingSenderId":"...","appId":"..."}
# FCM_VAPID_KEY: Project settings > Cloud Messaging > Web Push certificates > key pair.
# While FCM_SERVICE_ACCOUNT is empty nothing is pushed; riders and customers still see updates in the app.
FCM_SERVICE_ACCOUNT=
FCM_WEB_CONFIG=
FCM_VAPID_KEY=

# --- Email (notification module) ---
# Order updates, sign-in codes and password resets go out through this SMTP server. While SMTP_HOST
# or SMTP_FROM is empty, nothing is emailed: customers still see updates in the app, the back office
# Email log shows each message as "Not sent", and sign-in by email code and password reset do not work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM=
SMTP_FROM_NAME=FoodStack

# --- Card payments (payment module) ---
# none: cash only. stripe: Stripe Checkout (hosted page). sandbox: a test page that charges nothing,
# refused when FOODSTACK_ENVIRONMENT=production. Customers see card payment only when it is also
# switched on in the back office (Ordering page).
PAYMENT_GATEWAY=none
# Stripe: secret key (sk_live_... or sk_test_...) and the signing secret of a webhook endpoint that
# points at <FOODSTACK_PUBLIC_URL>/api/v1/payment-webhooks/stripe with the events
# checkout.session.completed, checkout.session.expired, checkout.session.async_payment_succeeded
# and checkout.session.async_payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe publishable key (pk_live_... or pk_test_...): needed only for card fields inside the app
# (Ordering page, "In card fields inside the app"); without it customers use Stripe's own page.
STRIPE_PUBLISHABLE_KEY=
# Sandbox only: any long random string, the same on every server replica.
PAYMENT_SANDBOX_SECRET=

# --- Sizing (set by install.sh from the server's memory) ---
JAVA_HEAP=2g
KAFKA_HEAP=1g
ES_HEAP=1g

# --- Account deletion (PRD ID-7) ---
# How long after a customer asks to delete their account it is deleted; signing in again cancels it.
FOODSTACK_IDENTITY_DELETION_GRACE=P14D
