# The proxy for Docker Compose (TDD 17.2): HTTPS, routing by path and security headers.
# FOODSTACK_SITES lists the site addresses, for example
#   "example.com, admin.example.com, api.example.com"   (automatic HTTPS)
#   "http://localhost"                                   (trial on your computer, no HTTPS)
{
	servers {
		trusted_proxies static private_ranges
	}
}

(foodstack) {
	encode zstd gzip
	request_body {
		max_size 25MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# No per-address rate limits here (ilyas, 2026-11-07): the FoodStack server limits sign-in,
	# email codes, coupon checks and order placement itself. Kubernetes adds edge limits.

	# The API (sign-in included) and the token keys: the FoodStack server (every module local).
	@server path /api/* /oauth2/* /.well-known/* /actuator/health/*
	handle @server {
		reverse_proxy server:8080 {
			health_uri /actuator/health/readiness
			health_interval 5s
		}
	}

	# Photos and files are in your buckets, which browsers reach directly. A trial on your own
	# computer (docker-compose.local.yml) adds a route to the storage on it here.
	import /etc/caddy/local/*.caddy

	# The back office; on its own hostname the root opens it.
	handle /admin* {
		reverse_proxy backoffice:8080
	}
	@adminRoot {
		host {$FOODSTACK_ADMIN_ROOT_HOST}
		path /
	}
	redir @adminRoot /admin/ 302

	# Everything else: the customer app (server-side rendered).
	handle {
		reverse_proxy web:4000
	}
}

{$FOODSTACK_SITES} {
	import foodstack
}
