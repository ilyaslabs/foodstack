# What Docker Compose itself needs. Copy this file to .env and fill it in; every FoodStack setting
# is in config/application.yml. Keep both files private (chmod 600): they hold passwords and keys.

# --- Version: the same for the server, the web app and the back office ---
FOODSTACK_VERSION=1.0.0

# --- Your addresses (handbook 11). One name for all three also works. ---
# The sites Caddy serves and gets HTTPS certificates for, comma separated.
FOODSTACK_SITES=example.com, admin.example.com, api.example.com
# The same names without spaces: the web app answers only these.
FOODSTACK_HOSTNAMES=example.com,admin.example.com,api.example.com
# The name whose root opens the back office (no-admin-host.invalid when it shares a name).
FOODSTACK_ADMIN_ROOT_HOST=admin.example.com
HTTP_PORT=80
HTTPS_PORT=443

# --- Datastore passwords: make each once with  openssl rand -hex 24  ---
# config/application.yml reads them from here, so they are written only once.
MONGODB_PASSWORD=REPLACE-with-a-password
REDIS_PASSWORD=REPLACE-with-a-password
ELASTICSEARCH_PASSWORD=REPLACE-with-a-password

# --- What the two web apps show (they don't read application.yml) ---
# Map tiles (handbook 13): any {z}/{x}/{y} service, its scheme and host, and the credit it asks for.
MAP_TILE_URL=https://tiles.example-provider.com/{z}/{x}/{y}.png?key=REPLACE
MAP_TILE_ORIGIN=https://tiles.example-provider.com
MAP_ATTRIBUTION=© Example provider © OpenStreetMap contributors
# Where the back office loads photos from and uploads to: your public bucket's address and your
# S3 endpoint (the same values as in config/application.yml), separated by a space.
MEDIA_ORIGINS=https://foodstack-public.s3.eu-west-1.amazonaws.com https://s3.eu-west-1.amazonaws.com

# --- Memory (a server with 8 GB: these defaults; 16 GB: 4g, 2g, 2g) ---
JAVA_HEAP=2g
KAFKA_HEAP=1g
ES_HEAP=1g
